{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(npm test:*)"
    ],
    "deny": []
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-bash.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "PreToolUse"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude is idle'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:9000/stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "Stop"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "SessionStart"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "UserPromptSubmit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "PostToolUse"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "PostToolUseFailure"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "PermissionRequest"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "StopFailure"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/logbook/bin/logbook",
            "args": [
              "hook",
              "claude-code",
              "SessionEnd"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "formatter@acme": true
  },
  "futureSetting": {
    "nested": [
      1,
      2.50,
      "x"
    ],
    "flag": null
  }
}
