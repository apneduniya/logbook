<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Logbook agent</title>
<style>
:root { color-scheme: light dark; --fg: #1d1d1f; --bg: #fff; --muted: #6e6e73; --line: #d2d2d7; --bad: #b3261e; --ok: #1e7b34; }
@media (prefers-color-scheme: dark) { :root { --fg: #f5f5f7; --bg: #161617; --muted: #a1a1a6; --line: #3a3a3c; --bad: #ff6b60; --ok: #5ad17a; } }
body { font: 15px/1.5 system-ui, sans-serif; color: var(--fg); background: var(--bg); margin: 0 auto; max-width: 44rem; padding: 1.5rem 1rem 3rem; }
h1 { font-size: 1.4rem; margin: 0 0 .25rem; }
h2 { font-size: 1rem; margin: 2rem 0 .5rem; }
p.sub { color: var(--muted); margin: 0; }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; padding: .35rem .5rem .35rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-weight: 500; color: var(--muted); width: 40%; }
.bad { color: var(--bad); }
.ok { color: var(--ok); }
.muted { color: var(--muted); }
code { font-size: .9em; }
</style>
</head>
<body>
<h1>Logbook agent</h1>
<p class="sub">Version {{.Version}} · {{if .DaemonRunning}}running since {{ago .StartedAt}}{{else}}not running{{end}} · updated {{ago .GeneratedAt}}</p>

<h2>Account</h2>
<table>
<tr><th>Server</th><td>{{.ServerURL}}</td></tr>
<tr><th>Signed in</th><td>{{if .SignedIn}}<span class="ok">yes</span>{{else}}<span class="bad">no</span> · run <code>logbook login --key &lt;key&gt;</code>{{end}}</td></tr>
<tr><th>Mirror to Hackatime</th><td>{{if .MirrorHost}}on ({{.MirrorHost}}){{else}}off{{end}}</td></tr>
</table>

{{define "uploader"}}
<tr><th>Waiting to send</th><td>{{.Queue.Pending}}{{if not .Queue.Oldest.IsZero}} <span class="muted">(oldest queued {{ago .Queue.Oldest}})</span>{{end}}</td></tr>
<tr><th>Last upload</th><td>{{ago .Worker.LastSuccess}}</td></tr>
{{if .Worker.Paused}}<tr><th>Paused</th><td class="bad">{{.Worker.Paused}}</td></tr>{{end}}
{{if .Worker.LastError}}<tr><th>Last error</th><td><span class="bad">{{.Worker.LastError}}</span> <span class="muted">{{ago .Worker.LastErrorAt}}</span></td></tr>{{end}}
{{if not .Worker.NextAttempt.IsZero}}<tr><th>Next try</th><td>{{ago .Worker.NextAttempt}}</td></tr>{{end}}
{{if .Queue.Dropped}}<tr><th>Dropped (queue full)</th><td class="bad">{{.Queue.Dropped}}</td></tr>{{end}}
{{if .Worker.Rejected}}<tr><th>Rejected by server</th><td>{{.Worker.Rejected}}</td></tr>{{end}}
{{end}}

<h2>Uploads to Logbook</h2>
<table>{{template "uploader" .Logbook}}</table>

<h2>Mirror to Hackatime</h2>
<table>{{template "uploader" .Hackatime}}</table>

<h2>Credited time and evidence</h2>
<table>
{{with .Crediting}}
<tr><th>Device</th><td>{{if .Device.ID}}<code>{{.Device.ID}}</code> <span class="muted">(registered {{ago .Device.RegisteredAt}})</span>{{else}}<span class="muted">not registered yet</span>{{end}}</td></tr>
{{if not .Device.RevokedAt.IsZero}}<tr><th>Revoked</th><td class="bad">{{ago .Device.RevokedAt}}</td></tr>{{end}}
<tr><th>Minutes computed</th><td>{{ago .Minutes.LastComputed}}</td></tr>
<tr><th>Minutes waiting to send</th><td>{{.Minutes.Waiting}}</td></tr>
<tr><th>Last upload</th><td>{{ago .Minutes.LastSuccess}}</td></tr>
{{if .Minutes.Paused}}<tr><th>Paused</th><td class="bad">{{.Minutes.Paused}}</td></tr>{{end}}
{{if .Minutes.LastError}}<tr><th>Last error</th><td><span class="bad">{{.Minutes.LastError}}</span> <span class="muted">{{ago .Minutes.LastErrorAt}}</span></td></tr>{{end}}
{{if not .Minutes.NextAttempt.IsZero}}<tr><th>Next try</th><td>{{ago .Minutes.NextAttempt}}</td></tr>{{end}}
{{if .Minutes.Refused}}<tr><th>Minutes on hold</th><td class="bad">{{.Minutes.Refused}}</td></tr>{{end}}
{{if .Minutes.Rejected}}<tr><th>Minutes rejected by server</th><td>{{.Minutes.Rejected}}</td></tr>{{end}}
{{if .Minutes.Clock}}<tr><th>Clock</th><td class="bad">{{.Minutes.Clock}}</td></tr>{{end}}
{{if .Minutes.Settling}}<tr><th>Settling</th><td>{{.Minutes.Settling}}</td></tr>{{end}}
{{if .Minutes.LateIgnored}}<tr><th>Late events ignored</th><td>{{.Minutes.LateIgnored}} <span class="muted">latest {{ago .Minutes.LateLatest}}</span></td></tr>{{end}}
<tr><th>Evidence chain</th><td>{{if .Evidence.LastDay}}signed through {{.Evidence.LastDay}} <span class="muted"><code>{{printf "%.12s" .Evidence.ChainHash}}</code></span>{{else}}<span class="muted">no day sealed yet</span>{{end}}</td></tr>
{{if .Evidence.State}}<tr><th>Evidence stopped</th><td class="bad">{{.Evidence.Error}}</td></tr>{{end}}
{{if .Evidence.LocalError}}<tr><th>Sealing failed (retrying)</th><td class="bad">{{.Evidence.LocalError}}</td></tr>{{end}}
{{end}}
</table>

<h2>AI tool hooks</h2>
<table>
{{if .Hooks}}{{range .Hooks}}<tr><th>{{.Name}}</th><td>{{.State}}</td></tr>{{end}}
{{else if unknown .Hooks}}<tr><th>Hooks</th><td class="muted">unknown</td></tr>
{{else}}<tr><th>Hooks</th><td class="muted">no AI tools detected</td></tr>{{end}}
</table>

<h2>Today on this device</h2>
<table>
<tr><th>Coding time (local estimate)</th><td>{{.Today.CodingText}}</td></tr>
<tr><th>Heartbeats</th><td>{{.Today.Heartbeats}}</td></tr>
<tr><th>AI events</th><td>{{.Today.AIEvents}}</td></tr>
<tr><th>Activity samples</th><td>{{.Today.ActivitySamples}}</td></tr>
<tr><th>Git events</th><td>{{.Today.GitEvents}}</td></tr>
{{if .SpoolBytes}}<tr><th>Hook events waiting</th><td>{{bytes .SpoolBytes}}</td></tr>{{end}}
</table>
<p class="muted">AI events, activity and git events stay on this device. Only heartbeats, credited minutes and one signed hash per day are uploaded.</p>
</body>
</html>
