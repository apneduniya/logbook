# Test fixtures are compared byte for byte (including CRLF and BOM ones),
# so git must never convert their line endings on Windows checkouts.
internal/agent/install/**/testdata/** -text
internal/agent/harness/**/testdata/** -text
pkg/**/testdata/** -text

# The installer scripts run on other machines straight from GitHub.
scripts/*.sh text eol=lf
scripts/*.ps1 text eol=crlf

# Struggle engine golden files are compared byte for byte.
pkg/struggle/testdata/** -text
