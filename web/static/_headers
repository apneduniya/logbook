# Cloudflare Pages response headers (the CSP itself is a <meta> tag that
# SvelteKit writes at build time; frame-ancestors can't go in a meta tag).
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Review links carry their credential in the path (docs/web.md, "Review page"):
# never indexed, never sent on as a Referer. Pages joins a repeated header with
# a comma, and browsers use the last policy listed, so no-referrer wins.
/r/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

# The consent page carries a pending request's id in its query: never indexed.
/oauth/*
  X-Robots-Tag: noindex, nofollow

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
